-- allium: 3
-- generation.allium
-- The generation lifecycle for Templateer V2.
--
-- A generation is the process of producing an artifact from a template.
-- The pipeline is synchronous and result-oriented: submitting a request
-- produces exactly one GenerationResult — success (with an artifact) or
-- failure (with a reason and detail). There is no observable in-flight
-- state; retries are internal to the pipeline and bounded by the
-- request's max_attempts.
--
-- Key invariant: a renderer may only receive validated structured data.
-- No raw LLM output, user prompt, or unrestricted filesystem context
-- reaches the renderer. The intermediate model is the contract.
--
-- Includes: GenerationRequest/GenerationResult entities, rules,
-- invariants, actors, and surfaces for the artifact generation
-- workshop and template catalogue.

use "./templates.allium" as templates


-- ============================================================================
-- Value types
-- ============================================================================

value ProjectFacts {
    facts: Map<String, Any>
}
-- Structured context about the project that helps fill the template schema.
-- Facts are template-specific and agent-supplied.
-- Examples: {"uses_fastapi": true, "package_manager": "uv"}


-- ============================================================================
-- Enumerations
-- ============================================================================

enum FailureReason {
    no_template
    | config_error
    | llm_failed
    | model_validation_failed
    | render_failed
    | output_validation_failed
}
-- Taxonomy of generation failure reasons.
-- no_template:              the named template does not exist in the catalog
-- config_error:             caller misconfiguration (missing API key, unknown model id)
-- llm_failed:               the LLM call itself failed (network, timeout, provider error)
-- model_validation_failed:  the LLM could not produce output satisfying the schema
-- render_failed:            the Jinja render step failed (schema/template drift, bad value)
-- output_validation_failed: the rendered artifact failed output validation


-- ============================================================================
-- Entities
-- ============================================================================

entity GenerationRequest {
    template_name: String
    -- The template to use, matching a Template.name in the catalog exactly.

    user_request: String
    -- What the caller wants generated.

    context: ProjectFacts?
    -- Optional project facts passed to the LLM as context.

    model_name: String
    -- The LLM model identifier; defaults to config.default_model.

    max_attempts: Integer
    -- Whole-pipeline attempts; defaults to config.max_attempts.
}
-- A request is created once and re-run unchanged by internal retries.


entity GenerationResult {
    request: GenerationRequest
    -- The request this result answers. Retries re-run the same request
    -- with attempt incremented.

    output_path: String?
    -- Where the artifact belongs. Set once the template has resolved:
    -- the artifact path comes from the template's metadata, not from the
    -- requester. Null only when the template itself was not found.

    model: Map<String, Any>?
    -- The validated model dump. Present when the LLM produced a model,
    -- regardless of later render/validation success.

    artifact: String?
    -- The rendered artifact. Present on success only.

    failure_reason: FailureReason?
    -- Why the generation failed. Null on success.

    error_detail: String?
    -- Human-readable failure text. Present on failure only.

    warnings: List<String>?
    -- Non-fatal validator notes (validators declared optional). Absent
    -- when there are none.

    attempt: Integer
    -- Which attempt produced this result (1-based).

    -- Derived
    succeeded: failure_reason = null
    can_retry: failure_reason in {llm_failed, model_validation_failed, output_validation_failed}
        and attempt < request.max_attempts
}
-- A result is built once at the exit point of the pipeline, never mutated
-- through a lifecycle. Success and failure are mutually exclusive by
-- construction, enforced by the invariants below.


-- ============================================================================
-- Config
-- ============================================================================

config {
    default_model: String = "openai:gpt-4.1-mini"
    max_attempts: Integer = 3
    model_output_retries: Integer = 2
}
-- model_output_retries is the LLM provider's *internal* budget for
-- re-asking the model when its output fails schema validation. It is
-- distinct from max_attempts, which re-runs the whole pipeline.


-- ============================================================================
-- Rules
-- ============================================================================

-- -----------------------------------------------------------
-- 1. Request submission
-- -----------------------------------------------------------

rule SubmitGeneration {
    when: GenerateArtifact(template_name, user_request, context?, model_name?, max_attempts?)

    ensures:
        let request = GenerationRequest.created(
            template_name: template_name,
            user_request: user_request,
            context: context,
            model_name: model_name ?? config.default_model,
            max_attempts: max_attempts ?? config.max_attempts
        )
        GenerationAttempted(request, 1)
    @guidance
        -- The caller names the template and describes the request. The
        -- artifact path is NOT caller-supplied: it is fixed by the chosen
        -- template's metadata (output.path).
}

-- -----------------------------------------------------------
-- 2. Template resolution (exact name match)
-- -----------------------------------------------------------

rule ResolveTemplate {
    when: GenerationAttempted(request, attempt)

    requires: templates/catalog.has_template(request.template_name)

    ensures: ProductionRequested(
        request: request,
        attempt: attempt,
        template: templates/catalog.find_template(request.template_name)
    )
    @guidance
        -- Template lookup is exact name match only. The template_name must
        -- match a Template.name in the catalog; a template that fails to
        -- load (missing or invalid metadata) is also classified as
        -- no_template by FailNoTemplate.
}

rule FailNoTemplate {
    when: GenerationAttempted(request, attempt)

    requires: not templates/catalog.has_template(request.template_name)

    ensures: GenerationResult.created(
        request: request,
        attempt: attempt,
        failure_reason: no_template,
        error_detail: "no template found with that name"
    )
    @guidance
        -- Permanent failure: retrying burns tokens to reach the same
        -- answer, so no_template is never retried.
}

-- -----------------------------------------------------------
-- 3. Model generation (external LLM process)
-- -----------------------------------------------------------

-- The LLM provider is an external process. In response to
-- ProductionRequested it emits exactly one of:
--   ModelReady(request, attempt, template, model)
--   ModelFailed(request, attempt, template, reason, detail)
-- where reason is one of config_error | llm_failed |
-- model_validation_failed.

rule FailModelGeneration {
    when: ModelFailed(request, attempt, template, reason, detail)

    requires: template != null
    requires: reason in {config_error, llm_failed, model_validation_failed}

    ensures: GenerationResult.created(
        request: request, output_path: template.output.path,
        attempt: attempt, failure_reason: reason, error_detail: detail
    )
    @guidance
        -- The provider classifies its own failure:
        --   config_error:            caller misconfiguration — missing API
        --     key, unknown model id. Permanent, never retried.
        --   model_validation_failed: the model's output could not satisfy
        --     the schema after the provider's internal re-ask budget
        --     (config.model_output_retries). Retryable.
        --   llm_failed:              network, timeout, provider error.
        --     Retryable.
        -- The validated model — when it exists — is the only thing that
        -- crosses from the LLM into the render step.
}

-- -----------------------------------------------------------
-- 4. Render + validate the artifact
-- -----------------------------------------------------------

rule RenderArtifact {
    when: ModelReady(request, attempt, template, model)

    requires: template != null

    let artifact = render(template, model)
    let errors = validate_errors(artifact, template.output.language, template.validators)
    let warnings = validate_warnings(artifact, template.output.language, template.validators)

    ensures:
        if artifact = null:
            GenerationResult.created(
                request: request, output_path: template.output.path,
                attempt: attempt, model: model,
                failure_reason: render_failed,
                error_detail: render_detail(template, model))
        else if errors.count > 0:
            GenerationResult.created(
                request: request, output_path: template.output.path,
                attempt: attempt, model: model,
                failure_reason: output_validation_failed,
                error_detail: join(errors, "; "))
        else:
            GenerationResult.created(
                request: request, output_path: template.output.path,
                attempt: attempt, model: model,
                artifact: artifact, warnings: warnings)
    @guidance
        -- render(template, model) is deterministic: the same validated
        -- model and template produce byte-identical output. It returns
        -- null when the template cannot be rendered — schema/template
        -- drift, an undefined variable, or a value that cannot be safely
        -- interpolated (interpolating a null value is an authoring error).
        --
        -- Output validation parses the artifact in the target language
        -- and runs the template's declared validators. Validators marked
        -- optional report warnings rather than errors.
}

-- -----------------------------------------------------------
-- 5. Retry (internal to the pipeline)
-- -----------------------------------------------------------

rule RetryFailedGeneration {
    when: result: GenerationResult.created

    requires: result.can_retry

    ensures: GenerationAttempted(result.request, result.attempt + 1)
    @guidance
        -- Retrying only helps for nondeterministic failures: llm_failed,
        -- model_validation_failed and output_validation_failed. Missing
        -- templates, missing API keys, and broken templates are permanent
        -- and never retried. There is no caller-invoked retry; the loop is
        -- internal and the final result carries the attempt count.
}


-- ============================================================================
-- Invariants
-- ============================================================================

invariant ArtifactImpliesSuccess {
    for r in GenerationResults:
        r.artifact != null implies r.failure_reason = null
}
-- An artifact is only present on success.

invariant SuccessImpliesArtifact {
    for r in GenerationResults:
        r.failure_reason = null implies r.artifact != null
}
-- Every successful result carries its artifact.

invariant FailureImpliesReason {
    for r in GenerationResults:
        r.failure_reason != null implies r.error_detail != null
}
-- Every failed result explains why.

invariant FailureExcludesArtifact {
    for r in GenerationResults:
        r.failure_reason != null implies r.artifact = null
}
-- Failure and artifact are mutually exclusive.

invariant AttemptWithinBudget {
    for r in GenerationResults:
        r.attempt <= r.request.max_attempts
}
-- The retry loop never exceeds the request's max_attempts.


-- ============================================================================
-- Surfaces
-- ============================================================================

surface ArtifactWorkshop {
    facing requester: templates/Requester

    exposes:
        for r in GenerationResults:
            r.request.template_name
            r.output_path
            r.model
            r.artifact
                when r.succeeded
            r.failure_reason
            r.error_detail
            r.warnings
            r.attempt
            r.succeeded
            r.can_retry

    provides:
        GenerateArtifact(
            template_name: String,
            user_request: String,
            context: ProjectFacts?,
            model_name: String?,
            max_attempts: Integer?
        ) when requester != null

    related:
        templates/TemplateCatalogue()
            when requester != null

    @guarantee StrictRenderContract
        -- The renderer receives only the validated model's data dump. No
        -- raw LLM response, user prompt, or unrestricted context reaches
        -- the template. Undefined template variables are errors, never
        -- silent empty strings.

    @guarantee DeterministicRender
        -- Given the same template and the same validated model data,
        -- rendering produces byte-identical output.

    @guarantee EscapedInterpolation
        -- Every value interpolated into an artifact is escaped for the
        -- target language at the render boundary, so a validated model
        -- cannot alter the artifact's structure: a value that lexes like
        -- string syntax (quotes, newlines, comments) round-trips as data.
        -- The escaping audit (AuditTemplate) probes every string field of
        -- every example fixture and reports zero findings.

    @guarantee FailuresAreResults
        -- Every generation outcome is a GenerationResult. A failure is
        -- data (failure_reason + error_detail), never an exception
        -- escaping the pipeline boundary.

    @guidance
        -- The requester identifies a template by name (directory name).
        -- Matching is exact: either a template with that name exists or it
        -- doesn't. No scoring, no confidence, no fuzzy matching.
        --
        -- To generate an artifact:
        --   1. Browse TemplateCatalogue to see what's available
        --   2. Call GenerateArtifact(template_name, user_request, ...)
        --   3. Read r.artifact on success, or r.failure_reason +
        --      r.error_detail on failure. Retries are internal; the result
        --      reports the final attempt.
}


-- ============================================================================
-- Open questions
-- ============================================================================

open question "Should completed results be retained for history or audit, or discarded after delivery?"
open question "Should ProjectFacts be template-specific value types instead of a generic key-value map?"
open question "Should there be a TemplateCustodian actor for template lifecycle management (add, remove, update templates)?"
open question "Should the surface distinguish between human and agent requesters, or are they identical as the spec assumes?"
